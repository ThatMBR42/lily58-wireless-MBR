#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        win_l {
            bindings = <&kp RG(L)>;
            key-positions = <23 22>;
            layers = <0>;
            require-prior-idle-ms = <500>;
            timeout-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7     &kp N8     &kp N9   &kp N0         &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp F     &kp P     &kp B                           &kp J   &kp L      &kp U      &kp Y    &kp SEMICOLON  &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp R   &kp S     &kp T     &kp G                           &kp M   &kp N      &kp E      &kp I    &kp O          &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C     &kp D     &kp V   &kp LBKT     &kp RBKT   &kp K   &kp H      &kp COMMA  &kp DOT  &kp FSLH       &kp RCTRL
                                &kp LALT  &kp LGUI  &mo 1   &kp ENTER    &kp SPACE  &mo 2   &kp LSHFT  &kp GRAVE
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &kp KP_NUMLOCK  &trans     &kp KP_SLASH  &kp KP_ASTERISK  &trans        &kp BACKSPACE
&trans      &trans        &trans        &trans        &trans        &trans                                &trans          &kp KP_N7  &kp KP_N8     &kp KP_N9        &trans        &trans
&kp F1      &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                                &trans          &kp KP_N4  &kp KP_N5     &kp KP_N6        &kp KP_PLUS   &kp KP_MINUS
&kp F7      &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &kp SPACE    &trans     &trans          &kp KP_N1  &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &trans
                                        &trans        &trans        &trans        &trans       &kp KP_N0  &trans          &trans     &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans            &trans               &trans               &trans               &trans                                           &trans  &trans    &trans     &trans     &trans     &trans
&trans  &trans            &kp LA(PRINTSCREEN)  &kp LS(PRINTSCREEN)  &kp LC(PRINTSCREEN)  &kp PRINTSCREEN                                  &trans  &trans    &trans     &trans     &trans     &trans
&trans  &kp SINGLE_QUOTE  &kp DQT              &kp COMMA            &kp DOT              &kp DELETE                                       &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans  &kp SEMI          &kp COLON            &kp SLASH            &kp QUESTION         &kp INSERT       &kp SCROLLLOCK    &kp CAPSLOCK  &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
                                               &trans               &trans               &trans           &trans            &trans        &trans  &trans    &trans
            >;
        };

        tri_layer {
            bindings = <
&trans  &trans     &trans         &trans         &trans     &trans                                  &trans     &trans     &trans            &kp LPAR           &kp RPAR  &trans
&trans  &trans     &kp LA(R)      &kp LA(S)      &kp LC(C)  &kp LC(LS(Y))                           &trans     &trans     &kp LT            &kp GT             &trans    &trans
&trans  &kp LC(A)  &trans         &kp LA(LC(V))  &kp LC(V)  &trans                                  &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans    &trans
&trans  &trans     &kp LC(LS(Q))  &trans         &trans     &trans         &kp LG(LS(S))    &trans  &kp UNDER  &kp PLUS   &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans    &trans
                                  &trans         &trans     &trans         &trans           &trans  &trans     &trans     &trans
            >;

            label = "Tri";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to_tri {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
