#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    combos {
        compatible = "zmk,combos";

        win_l {
            bindings = <&kp RG(L)>;
            key-positions = <23 22>;
            layers = <0>;
            require-prior-idle-ms = <500>;
            timeout-ms = <250>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
        };

        lh_pht: lh_pht {
            compatible = "zmk,behavior-hold-tap";
            label = "LH_PHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <6 7 8 9 10 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57 43 54>;
            flavor = "tap-unless-interrupted";
            require-prior-idle-ms = <125>;
        };

        rh_pht: rh_pht {
            compatible = "zmk,behavior-hold-tap";
            label = "RH_PHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <200>;
            flavor = "tap-unless-interrupted";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53>;
            require-prior-idle-ms = <125>;
        };

        tp_hrm: tp_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "Tap-Preferred HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            flavor = "tap-preferred";
        };

        bt_ht: bt_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "BT Hold Tap";
            bindings = <&bt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <2000>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC         &kp N1           &kp N2           &kp N3                &kp N4                  &kp N5                            &kp N6  &kp N7                   &kp N8                 &kp N9            &kp N0            &kp BACKSPACE
&kp TAB         &kp Q            &kp W            &kp F                 &kp P                   &kp B                             &kp J   &kp L                    &kp U                  &kp Y             &kp SEMICOLON     &kp MINUS
&kp LEFT_SHIFT  &hrm LEFT_GUI A  &hrm LEFT_ALT R  &tp_hrm LEFT_SHIFT S  &tp_hrm LEFT_CONTROL T  &kp G                             &kp M   &tp_hrm RIGHT_CONTROL N  &tp_hrm RIGHT_SHIFT E  &hrm RIGHT_ALT I  &hrm RIGHT_GUI O  &kp APOS
&kp LCTRL       &kp Z            &kp X            &kp C                 &kp D                   &kp V   &kp LBKT       &kp RBKT   &kp K   &kp H                    &kp COMMA              &kp DOT           &kp FSLH          &kp RCTRL
                                                  &kp LALT              &kp LEFT_GUI            &mo 1   &lt 3 ENTER    &kp SPACE  &mo 2   &key_repeat              &kp GRAVE
            >;
        };

        num_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Num";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &kp KP_NUMLOCK  &trans     &kp KP_SLASH  &kp KP_ASTERISK  &trans        &kp BACKSPACE
&trans      &kp F1        &kp F2        &kp F3        &kp F4        &trans                            &trans          &kp KP_N7  &kp KP_N8     &kp KP_N9        &trans        &kp BACKSLASH
&trans      &kp F5        &kp F6        &kp F7        &kp F8        &kp SEMICOLON                     &kp EQUAL       &kp KP_N4  &kp KP_N5     &kp KP_N6        &kp KP_PLUS   &kp KP_MINUS
&trans      &kp F9        &kp F10       &kp F11       &kp F12       &kp COLON      &kp DEL    &trans  &kp UNDER       &kp KP_N1  &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &trans
                                        &trans        &trans        &trans         &trans     &trans  &kp KP_N0       &trans     &kp KP_DOT
            >;
        };

        sym_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Sym";
            bindings = <
&trans  &kp EXCL          &kp AT               &kp HASH             &kp DOLLAR           &kp PERCENT                                      &kp CARET    &kp AMPS   &kp ASTERISK  &kp LPAR   &kp RPAR   &trans
&trans  &trans            &kp LA(PRINTSCREEN)  &kp LS(PRINTSCREEN)  &kp LC(PRINTSCREEN)  &kp PRINTSCREEN                                  &trans       &kp EQUAL  &kp PLUS      &kp MINUS  &trans     &kp BACKSLASH
&trans  &kp SINGLE_QUOTE  &kp DQT              &kp COMMA            &kp DOT              &kp DELETE                                       &key_repeat  &kp LEFT   &kp DOWN      &kp UP     &kp RIGHT  &trans
&trans  &kp SEMI          &kp COLON            &kp SLASH            &kp QUESTION         &kp INSERT       &kp SCROLLLOCK    &kp CAPSLOCK  &trans       &kp HOME   &kp PG_DN     &kp PG_UP  &kp END    &trans
                                               &trans               &trans               &kp SPACE        &trans            &trans        &trans       &trans     &trans
            >;
        };

        tri_layer {
            bindings = <
&trans  &trans     &trans         &trans         &trans     &trans                                  &trans     &trans     &trans            &kp LPAR           &kp RPAR   &trans
&trans  &trans     &kp LA(R)      &kp LA(S)      &kp LC(C)  &kp LC(LS(Y))                           &trans     &trans     &kp LT            &kp GT             &trans     &kp BACKSLASH
&trans  &kp LC(A)  &kp Y          &kp LA(LC(V))  &kp LC(V)  &kp N                                   &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI   &trans
&trans  &mkp MCLK  &kp LC(LS(Q))  &mkp RCLK      &mkp LCLK  &trans         &kp LG(LS(S))    &trans  &kp UNDER  &kp PLUS   &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp COLON  &trans
                                  &trans         &trans     &trans         &trans           &trans  &trans     &trans     &trans
            >;

            label = "Tri";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
